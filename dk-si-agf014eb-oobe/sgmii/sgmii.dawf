::drc::add_waiver \
	-description {Permanent Waiver: EMIF HPS IP issues partial min-delay assignments without matching max-delay.} \
	-rule_id {TMC-20021} \
	-query_string {Assignment =~ 'soc_inst|emif_hps|altera_emif_fm_hps_inst|arch|arch_inst' && Reason =~ 'Min delay for this path exists but no max delay was set.' && Location =~ 'emif_hps_altera_emif_arch_fm'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2024-10-09*15:46:53} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: Multiple asynchronous reset synchronizers in MAIN_CLOCK are expected in this design (system reset, JTAG Avalon masters, and fabric/SDM reset sources). These domains are intentionally synchronized to the same clock and do not indicate a functional reset hazard for this reference design.} \
	-rule_id {RDC-50003} \
	-query_string {"Reset Clock Domain" =~ 'MAIN_CLOCK' && "Reset Chain Register Heads" =~ 'sys_rst_inst|altera_reset_synchronizer_int_chain' && "Reset Sources" =~ 'auto_fab_0|alt_sld_fab_0'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2025-02-20*17:36:55} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: EMIF HPS IP SDC contains false-path and min-delay exceptions that are invalid for this design configuration because they cover no paths. These are unused IP-generated constraints and do not affect timing correctness.} \
	-rule_id {TMC-20025} \
	-query_string {Reason == 'Exception is invalid (covers no paths)' && Location =~ 'emif_hps_altera_emif_arch_fm'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2026-08-05*11:00:00} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: User reset clock-gate IP SDC set_clock_groups on internal_clk is invalid for this design configuration because it covers no paths. This unused IP-generated constraint does not affect timing correctness.} \
	-rule_id {TMC-20025} \
	-query_string {Reason == 'Exception is invalid (covers no paths)' && Location =~ 'altera_s10_user_rst_clkgate_fm.sdc'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2026-08-05*11:00:00} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: Clock group flag is not a true asynchronous clock-group violation; the clocks share the same physical target through a clock mux, so an exclusive flag is appropriate rather than asynchronous.} \
	-rule_id {CLK-30042} \
	-query_string {"Clock Group Flag" == '-logically_exclusive' && "Clock Groups" == '[get_ports {enet_refclk}] - hps_emac1_gtx_clk' && "Recommended Flag" == '-asynchronous'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2026-07-07*11:24:00} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: Partial multicycle assignment originates from Ethernet TSE / LVDS IP SDC (hold multicycle without setup multicycle) and is safe for this reference design configuration.} \
	-rule_id {TMC-20019} \
	-query_string {Assignment =~ '-from [get_keepers {soc_inst|subsys_sgmii_emac1|eth_tse_0|altera_eth_tse_inst|i_lvdsio_tx_0|core|arch_inst*ufi_write_reg}]' && Reason =~ 'Hold multicycle for this path exists but no setup multicycle was set'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2025-12-04*10:36:20} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: Collection filter matching multiple types originates from Ethernet TSE / LVDS IP SDC and does not affect timing correctness for this reference design.} \
	-rule_id {TMC-20027} \
	-query_string {"Bare String Filter" == 'soc_inst|subsys_sgmii_emac1|eth_tse_0|altera_eth_tse_inst|i_lvdsio_rx_0|core|arch_inst|rx_channels[0].soft_cdr.rx_dpa_locked_sync_inst|sync_inst|din_s1' && "SDC Command" =~ 'set_false_path -from ${dpa_inst_name}~dpa_reg -to ${dpa_inst_name_short}.rx_dpa_locked_sync_inst|sync_inst|din_s1'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2025-12-04*10:39:47} \
	-owner {user} \
	-no_warn

::drc::add_waiver \
	-description {Permanent Waiver: Invalid multicycle assignment originates from Ethernet TSE / LVDS IP SDC and does not affect timing correctness for this reference design.} \
	-rule_id {TMC-20020} \
	-query_string {Assignment =~ '-from [get_keepers {soc_inst|subsys_sgmii_emac1|eth_tse_0|altera_eth_tse_inst|i_lvdsio_tx_0|core|arch_inst|tx_channels[*].tx.ser[*].txin_ufi~ufi_read_reg}]' && Reason =~ 'Setup multicycle for this path is equal to or less than hold multicycle'} \
	-stages {{Timing Signoff}} \
	-tag {} \
	-timestamp {2025-12-04*10:41:43} \
	-owner {user} \
	-no_warn

