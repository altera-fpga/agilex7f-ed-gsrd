# Standard Quartus generated directories
/dni/
/output_files/
/qdb/
/tmp-clearbox/

# Log files created by Quartus
quartus.log
quartus.rec
quartus.rec.log.flock
quartus.log.save
quartus.rec.save
serv_req_info.txt
*.qws
*.qdf
*.rpt

# Files generated by Qsys (legacy)
*.qsys.legacy
board.info
**/.qsys_edit/

# Quartus backup files
*.qsf.backup
*.bak.*

# VDS generated directories (root-level and inside subsystems)
/gen/
src/vds/*/gen/

# Standalone IP generated subdirectories
# Keep only the *.ip source file at src/ip/*.ip level;
# ignore the generated RTL folder that quartus_ipgenerate creates beside it.
/src/ip/*/

# Quartus-generated support logic directory
/support_logic/

# Simscript directories
/sim_setup_*/

