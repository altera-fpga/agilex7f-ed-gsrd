# Quartus version assignments
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 26.3.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "01:05:17  JUNE 07, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "26.3.0 Pro Edition"

# Device properties
set_global_assignment -name FAMILY "Agilex 7"
set_global_assignment -name DEVICE AGMF039R47A1E1VC

# Toplevel and toplevel RTL
set_global_assignment -name TOP_LEVEL_ENTITY ghrd_agilex_top

# Flow assignments
# Put all reports into the output_files directory
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
# Include custom IP in IP search path
set_global_assignment -name IP_SEARCH_PATHS "intel_custom_ip/**/*;custom_ip/**/*"
# Convert timing failures to errors
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 332148
set_global_assignment -name PROMOTE_WARNING_TO_ERROR 12677

# Configuration Assignments
set_global_assignment -name HPS_DAP_NO_CERTIFICATE on
set_global_assignment -name ENABLE_INTERMEDIATE_SNAPSHOTS ON
set_global_assignment -name USE_HPS_COLD_RESET SDM_IO12
set_global_assignment -name USE_CONF_DONE SDM_IO5
set_global_assignment -name HPS_INITIALIZATION "HPS FIRST"
set_global_assignment -name DEVICE_INITIALIZATION_CLOCK OSC_CLK_1_125MHZ
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "AVST X8"
set_global_assignment -name HPS_DAP_SPLIT_MODE "SDM PINS"
set_global_assignment -name VID_OPERATION_MODE "PMBUS MASTER"
set_global_assignment -name USE_PWRMGT_SCL SDM_IO0
set_global_assignment -name USE_PWRMGT_SDA SDM_IO16
set_global_assignment -name PWRMGT_BUS_SPEED_MODE "400 KHZ"
